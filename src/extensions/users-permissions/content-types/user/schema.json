{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "phoneNumber": {
      "type": "biginteger"
    },
    "distribute_drafts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::publish-distribute.publish-distribute",
      "mappedBy": "UserDetail"
    },
    "artist_details": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::artist-detail.artist-detail",
      "mappedBy": "owner"
    },
    "Profile_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "currency": {
      "type": "string"
    },
    "dob": {
      "type": "date"
    },
    "notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "users_permissions_user"
    },
    "user_type": {
      "type": "enumeration",
      "enum": [
        "basic",
        "subscribed",
        "enterprise"
      ]
    },
    "label_fee_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::label-fee-history.label-fee-history",
      "mappedBy": "users_permissions_user"
    },
    "admin_fee_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::admin-fee-history.admin-fee-history",
      "mappedBy": "users_permissions_user"
    },
    "invoices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice.invoice",
      "mappedBy": "users_permissions_user"
    },
    "published_track_update_logs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::published-track-update-log.published-track-update-log",
      "mappedBy": "users_permissions_user"
    },
    "platformFeeOverride": {
      "type": "decimal"
    },
    "commissionOverride": {
      "type": "decimal"
    },
    "availableBalance": {
      "type": "decimal",
      "default": 0
    },
    "pendingBalance": {
      "type": "decimal",
      "default": 0
    },
    "paymentMethod": {
      "type": "json"
    },
    "subscriptionStatus": {
      "type": "enumeration",
      "enum": [
        "active",
        "expired",
        "cancelled"
      ]
    },
    "subscriptionStartDate": {
      "type": "date"
    },
    "subscriptionEndDate": {
      "type": "date"
    },
    "plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::plan.plan",
      "inversedBy": "users_permissions_users"
    },
    "payout_requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payout-request.payout-request",
      "mappedBy": "user"
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "audit_logs",
  "info": {
    "singularName": "audit-log",
    "pluralName": "audit-logs",
    "displayName": "Audit Log",
    "description": "Append-only log of mutating admin actions for compliance review"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "actor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "actorEmail": {
      "type": "string"
    },
    "impersonatedUserId": {
      "type": "integer"
    },
    "action": {
      "type": "string",
      "required": true
    },
    "method": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "targetType": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "statusCode": {
      "type": "integer"
    },
    "ipAddress": {
      "type": "string"
    },
    "userAgent": {
      "type": "string"
    },
    "metadata": {
      "type": "json"
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "payment_logs",
  "info": {
    "singularName": "payment-log",
    "pluralName": "payment-logs",
    "displayName": "payment-log"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "payment_logs"
    },
    "plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::plan.plan",
      "inversedBy": "payment_logs"
    },
    "stripeSessionId": {
      "type": "string",
      "unique": true
    },
    "paymentIntentId": {
      "type": "string"
    },
    "amount": {
      "type": "decimal"
    },
    "currency": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "success",
        "failed"
      ]
    },
    "paidAt": {
      "type": "datetime"
    }
  }
}
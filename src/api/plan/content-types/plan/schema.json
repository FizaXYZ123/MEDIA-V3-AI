{
  "kind": "collectionType",
  "collectionName": "plans",
  "info": {
    "singularName": "plan",
    "pluralName": "plans",
    "displayName": "Plan",
    "description": "Subscription plans available to artists"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "price_inr": {
      "type": "decimal"
    },
    "price_cad": {
      "type": "decimal"
    },
    "price_usd": {
      "type": "decimal"
    },
    "billingCycle": {
      "type": "enumeration",
      "enum": [
        "yearly"
      ],
      "default": "yearly"
    },
    "defaultCommission": {
      "type": "decimal",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "default_label_fee": {
      "type": "integer"
    },
    "default_admin_fee": {
      "type": "integer"
    },
    "maxPrimaryArtists": {
      "type": "string"
    },
    "priority_order": {
      "type": "integer"
    },
    "user_subscriptions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-subscription.user-subscription",
      "mappedBy": "plan"
    },
    "payment_logs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment-log.payment-log",
      "mappedBy": "plan"
    }
  }
}

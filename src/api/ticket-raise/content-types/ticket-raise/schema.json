{
  "kind": "collectionType",
  "collectionName": "ticket_raises",
  "info": {
    "singularName": "ticket-raise",
    "pluralName": "ticket-raises",
    "displayName": "Ticket Raise",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "ticketNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "default": "open"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "content_management",
        "arrange_meeting_call",
        "quality_control_process",
        "copyright_claims",
        "invoices_and_payments",
        "technical_issue",
        "terminate_my_contract",
        "general_question",
        "other"
      ],
      "default": "general_question",
      "required": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "ticket_raises"
    },
    "assignedTo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "assigned_tickets"
    },
    "assignedAt": {
      "type": "datetime"
    },
    "resolvedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "resolved_tickets"
    },
    "resolvedAt": {
      "type": "datetime"
    },
    "feedbackEmoji": {
      "type": "enumeration",
      "enum": [
        "bad",
        "okay",
        "good",
        "excellent"
      ]
    },
    "feedbackComment": {
      "type": "text"
    },
    "feedbackSubmittedAt": {
      "type": "datetime"
    },
    "lastActivityAt": {
      "type": "datetime"
    },
    "messages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ticket-message.ticket-message",
      "mappedBy": "ticket"
    }
  }
}